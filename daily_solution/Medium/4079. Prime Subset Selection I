class Solution {
    static boolean prime(int n) {
        if (n <= 1) return false;
        if (n == 2) return true;
        if (n % 2 == 0) return false;

        for (int i = 3; i * i <= n; i += 2) {
            if (n % i == 0) {
                return false;
            }
        }
        return true;
    }

    public List<Integer> maxPrimes(int n, int s) {
        List<Integer> result = new ArrayList<>();
        int sum = 0;

        for (int i = 2; i <= n; i++) {
            if (prime(i)) {
                if (sum + i > s) {
                    break;
                }

                sum += i;
                result.add(i);
            }
        }

        return result;
    }
}
